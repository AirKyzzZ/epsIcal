# Hyperplanning iCal subscription URL.
# Get it from your espace: click the .ical button > "Copier l'adresse".
# Contains a personal icalsecurise token — never commit this file.
HP_ICAL_URL=https://cd-XXXX.hyperplanning.fr/hp/Telechargements/ical/Edt_NAME.ics?version=...&icalsecurise=...&param=...

# Server port (default: 3333)
PORT=3333
